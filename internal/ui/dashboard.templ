package ui

import (
	"fmt"
	"html"
	"regexp"
	"time"
)

// DashboardData contains all data for the dashboard view
type DashboardData struct {
	Tasks     []Task
	Events    []Event
	Habits    []Habit
	Stats     Stats
	Session   *Session
	Connected bool
	Date      string // "Thu, Jan 16"
}

// Task represents a task item
type Task struct {
	GUID     string
	Title    string
	Source   string
	Status   string // "pending", "in_progress", "done"
	Estimate string // "30m", "1h", "2h"
	Time     string // "2pm" - scheduled time
}

// Event represents a calendar event
type Event struct {
	ID       string
	Title    string
	Time     string // "2:00 PM"
	Duration string // "1h"
	Location string
}

// Habit represents a habit to track
type Habit struct {
	ID       string
	Name     string
	Icon     string
	Type     string // "virtue" or "vice"
	Done     bool
	Progress int // 0-100
}

// Stats represents daily statistics
type Stats struct {
	Planned   int
	Completed int
	Queued    int
}

// Session represents the current work session
type Session struct {
	Active    bool
	TaskGUID  string
	TaskTitle string
	TaskSource string
	Elapsed   int // seconds
}

// Dashboard renders the main dashboard view
templ Dashboard(data DashboardData) {
	<div class="dashboard">
		<!-- TIMELINE -->
		<div class="db-panel">
			<div class="db-panel-head">
				<span class="db-panel-label">Timeline</span>
				<span class="db-panel-meta">{ data.Date }</span>
			</div>
			<div class="db-timeline-wrap">
				<div class="db-timeline-body">
					@Timeline(data.Tasks, data.Events)
				</div>
			</div>
		</div>

		<!-- FOCUS -->
		<div class="db-panel db-focus">
			if data.Session != nil && data.Session.Active {
				@FocusActive(data.Session)
			} else {
				@FocusIdle()
			}
		</div>

		<!-- QUEUE -->
		<div class="db-panel">
			<div class="db-panel-head">
				<span class="db-panel-label">Up Next</span>
				<span class="db-panel-meta">{ fmt.Sprintf("%d tasks", countPending(data.Tasks)) }</span>
			</div>
			<div class="db-queue-body">
				@TaskQueue(data.Tasks)
			</div>
		</div>

		<!-- AMBIENT -->
		<div class="db-panel db-ambient">
			<div class="db-panel-head">
				<span class="db-panel-label">Today</span>
				<div class={ "db-connection", templ.KV("connected", data.Connected) }>
					<span class="db-connection-dot"></span>
					if data.Connected {
						<span class="db-connection-text">Connected</span>
					} else {
						<span class="db-connection-text">Offline</span>
					}
				</div>
			</div>
			<div class="db-ambient-body">
				@AmbientPanel(data)
			</div>
		</div>
	</div>
}

// Timeline renders the hour grid with tasks and events
templ Timeline(tasks []Task, events []Event) {
	for hour := 6; hour <= 21; hour++ {
		<div class={ "db-hour-row", templ.KV("now", isNow(hour)), templ.KV("past", isPast(hour)) }>
			<div class="db-hour-num">{ formatHour(hour) }</div>
			<div class="db-hour-track">
				@BlocksAtHour(tasks, events, hour)
			</div>
		</div>
	}
}

// BlocksAtHour renders task blocks and calendar events at a specific hour
templ BlocksAtHour(tasks []Task, events []Event, hour int) {
	// Show events at this hour
	for _, event := range events {
		if eventAtHour(event, hour) {
			<div class={ "db-block", "cal", templ.KV("past", isPast(hour)) }>
				<div class="db-block-text">
					<div class="db-block-title">{ event.Title }</div>
					if event.Location != "" {
						<div class="db-block-sub">{ event.Location }</div>
					}
				</div>
				if event.Duration != "" {
					<div class="db-block-dur">{ event.Duration }</div>
				}
			</div>
		}
	}
	// Show tasks at this hour (for now, just current task at current hour)
	for _, task := range tasks {
		if task.Status == "in_progress" && isNow(hour) {
			<div class="db-block current" data-guid={ task.GUID }>
				<div class="db-block-dot"></div>
				<div class="db-block-text">
					<div class="db-block-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
					if task.Source != "" {
						<div class="db-block-sub">{ task.Source }</div>
					}
				</div>
				if task.Estimate != "" {
					<div class="db-block-dur">{ task.Estimate }</div>
				}
			</div>
		}
	}
}

// FocusActive renders the focus panel when a session is active
templ FocusActive(session *Session) {
	<div class="db-focus-status">
		<div class="db-focus-status-dot"></div>
		<span class="db-focus-status-text">In Progress</span>
	</div>
	<div class="db-focus-ring-wrap">
		<svg class="db-focus-ring" viewBox="0 0 320 320">
			<circle class="db-ring-bg" cx="160" cy="160" r="150"/>
			<circle class="db-ring-progress" cx="160" cy="160" r="150" id="ring-progress"/>
		</svg>
		<div class="db-focus-center">
			<div class="db-focus-time" id="timer">{ formatElapsed(session.Elapsed) }</div>
			<div class="db-focus-unit">elapsed</div>
		</div>
	</div>
	<div class="db-focus-task">@templ.Raw(renderMarkdownTitle(session.TaskTitle))</div>
	if session.TaskSource != "" {
		<div class="db-focus-source">{ session.TaskSource }</div>
	}
	<div class="db-focus-actions">
		<button class="db-btn db-btn-ghost" data-action="pause-session">⏸ Pause</button>
		<button class="db-btn db-btn-primary" data-action="complete-session">✓ Complete</button>
	</div>
}

// FocusIdle renders the focus panel when no session is active
templ FocusIdle() {
	<div class="db-focus-idle">
		<div class="db-focus-ring-wrap">
			<svg class="db-focus-ring" viewBox="0 0 320 320">
				<circle class="db-ring-bg" cx="160" cy="160" r="150"/>
				<circle class="db-ring-progress idle" cx="160" cy="160" r="150"/>
			</svg>
			<div class="db-focus-center">
				<div class="db-focus-time idle">0:00</div>
				<div class="db-focus-unit">ready</div>
			</div>
		</div>
		<div class="db-focus-task idle">Select a task to begin</div>
		<div class="db-focus-hint">Choose from the queue or timeline</div>
	</div>
}

// TaskQueue renders the task queue
templ TaskQueue(tasks []Task) {
	if len(tasks) == 0 {
		<div class="db-queue-empty">
			<div class="db-queue-empty-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
					<rect x="9" y="3" width="6" height="4" rx="1"/>
				</svg>
			</div>
			<p class="db-queue-empty-title">No tasks for today</p>
			<p class="db-queue-empty-hint">Add tasks to your daily note in Thymer</p>
		</div>
	} else {
		// Show pending/in_progress first
		for i, task := range tasks {
			if task.Status != "done" {
				<div
					class={ "db-q-item", templ.KV("next", i == 0 && task.Status != "in_progress") }
					data-guid={ task.GUID }
					data-action="select-task"
				>
					<div class="db-q-head">
						<div class="db-q-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
						if task.Time != "" {
							<div class="db-q-time">{ task.Time }</div>
						}
					</div>
					<div class="db-q-meta">
						if task.Source != "" {
							<span>{ task.Source }</span>
						}
						if task.Estimate != "" {
							<span>~{ task.Estimate }</span>
						}
					</div>
				</div>
			}
		}
		// Show completed at the end
		for _, task := range tasks {
			if task.Status == "done" {
				<div
					class="db-q-item done"
					data-guid={ task.GUID }
				>
					<div class="db-q-head">
						<div class="db-q-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
					</div>
					<div class="db-q-meta">
						if task.Source != "" {
							<span>{ task.Source }</span>
						}
					</div>
				</div>
			}
		}
	}
}

// AmbientPanel renders the right sidebar with stats, calendar, habits
templ AmbientPanel(data DashboardData) {
	<!-- Stats -->
	<div class="db-stats">
		<div class="db-stat">
			<span class="db-stat-icon">📋</span>
			<span class="db-stat-val">{ fmt.Sprintf("%d", data.Stats.Planned) }</span>
		</div>
		<div class="db-stat">
			<span class="db-stat-icon">✓</span>
			<span class={ "db-stat-val", templ.KV("good", data.Stats.Completed > 0) }>{ fmt.Sprintf("%d", data.Stats.Completed) }</span>
		</div>
		<div class="db-stat">
			<span class="db-stat-icon">⏳</span>
			<span class="db-stat-val">{ fmt.Sprintf("%d", data.Stats.Queued) }</span>
		</div>
	</div>

	<!-- Upcoming Calendar -->
	<div class="db-upcoming">
		<div class="db-section-label">Coming Up</div>
		if len(data.Events) == 0 {
			<div class="db-upcoming-empty">No events today</div>
		} else {
			for _, event := range data.Events {
				<div class="db-up-item">
					<span class="db-up-time">{ event.Time }</span>
					<span class="db-up-title">{ event.Title }</span>
				</div>
			}
		}
	</div>

	<!-- Habits -->
	<div class="db-habits">
		<div class="db-section-label">Habits</div>
		if len(data.Habits) == 0 {
			<div class="db-habits-empty">No habits configured</div>
		} else {
			for _, habit := range data.Habits {
				<div
					class={ "db-habit-item", habit.Type, templ.KV("done", habit.Done) }
					data-habit={ habit.ID }
					data-action="toggle-habit"
				>
					<span class="db-habit-icon">{ habit.Icon }</span>
					<div class="db-habit-info">
						<div class="db-habit-name">{ habit.Name }</div>
						<div class="db-habit-track">
							<div class="db-habit-progress" style={ fmt.Sprintf("width: %d%%", habit.Progress) }></div>
						</div>
					</div>
					<div class="db-habit-check">
						if habit.Done {
							if habit.Type == "vice" {
								✗
							} else {
								✓
							}
						}
					</div>
				</div>
			}
		}
	</div>
}

// Helper functions
func countPending(tasks []Task) int {
	count := 0
	for _, t := range tasks {
		if t.Status != "done" {
			count++
		}
	}
	return count
}

func isPast(hour int) bool {
	return hour < time.Now().Hour()
}

func isNow(hour int) bool {
	return hour == time.Now().Hour()
}

func formatHour(hour int) string {
	if hour == 0 {
		return "12a"
	} else if hour < 12 {
		return fmt.Sprintf("%da", hour)
	} else if hour == 12 {
		return "12p"
	}
	return fmt.Sprintf("%dp", hour-12)
}

func formatElapsed(seconds int) string {
	h := seconds / 3600
	m := (seconds % 3600) / 60
	s := seconds % 60
	if h > 0 {
		return fmt.Sprintf("%d:%02d:%02d", h, m, s)
	}
	return fmt.Sprintf("%d:%02d", m, s)
}

func eventAtHour(event Event, hour int) bool {
	// Parse event time and check if it's at this hour
	// For now, simple check - would need proper time parsing
	t, err := time.Parse("3:04 PM", event.Time)
	if err != nil {
		return false
	}
	return t.Hour() == hour
}

// renderMarkdownTitle converts markdown links to HTML with thymer: links styled
var markdownLinkRe = regexp.MustCompile(`\[([^\]]+)\]\((thymer:[^)]+)\)`)

func renderMarkdownTitle(title string) string {
	// Escape HTML first
	escaped := html.EscapeString(title)

	// Replace markdown links with HTML links
	result := markdownLinkRe.ReplaceAllStringFunc(escaped, func(match string) string {
		parts := markdownLinkRe.FindStringSubmatch(match)
		if len(parts) != 3 {
			return match
		}
		linkText := parts[1]
		linkHref := parts[2]
		return fmt.Sprintf(`<a href="%s" class="thymer-link">%s</a>`, linkHref, linkText)
	})

	return result
}
