package ui

import (
	"fmt"
)

// DashboardData contains all data for the dashboard view
type DashboardData struct {
	Tasks     GroupedTasks       // Tasks grouped by category
	Events    []Event
	Habits    []Habit
	Stats     Stats
	Session   *Session
	Sessions  []CompletedSession // Completed sessions for timeline
	Connected bool
	Date      string // "Thu, Jan 16"
}

// GroupedTasks holds tasks separated by category for queue display
type GroupedTasks struct {
	Scheduled []Task // Has PlannedSlots, sorted by earliest start time
	Floating  []Task // No PlannedSlots, not done, user-ordered
	Done      []Task // Status == "done"
}

// All returns all tasks combined (for timeline rendering)
func (g GroupedTasks) All() []Task {
	all := make([]Task, 0, len(g.Scheduled)+len(g.Floating)+len(g.Done))
	all = append(all, g.Scheduled...)
	all = append(all, g.Floating...)
	all = append(all, g.Done...)
	return all
}

// PendingCount returns the count of non-done tasks
func (g GroupedTasks) PendingCount() int {
	return len(g.Scheduled) + len(g.Floating)
}

// CompletedSession represents a completed work session for the timeline
type CompletedSession struct {
	ID        string
	TaskGUID  string
	TaskTitle string
	StartedAt string // RFC3339 time
	EndedAt   string // RFC3339 time
	Elapsed   int    // seconds
}

// Task represents a task item
type Task struct {
	GUID         string
	Title        string
	Source       string
	Status       string // "pending", "in_progress", "done"
	Estimate     string // "30m", "1h", "2h"
	Time         string // "2pm" - scheduled time
	ElapsedToday int    // seconds worked today
	SessionCount int    // number of sessions today
	PlannedSlots []PlannedSlot // multiple time slots from drag-drop
	Color        int           // 0-9 for pastel rotation
}

// PlannedSlot represents a single scheduled time slot
type PlannedSlot struct {
	StartTime string // "14:00" (24h format)
	Duration  int    // minutes
}

// Event represents a calendar event
type Event struct {
	ID       string
	Title    string
	Time     string // "2:00 PM"
	Duration string // "1h"
	Location string
}

// Habit represents a habit to track
type Habit struct {
	ID       string
	Name     string
	Icon     string
	Type     string // "virtue" or "vice"
	Done     bool
	Progress int // 0-100
}

// Stats represents daily statistics
type Stats struct {
	Planned   int
	Completed int
	Queued    int
}

// Session represents the current work session
type Session struct {
	Active     bool
	Paused     bool
	TaskGUID   string
	TaskTitle  string
	TaskSource string
	Elapsed    int // seconds
}

// Dashboard renders the main dashboard view
templ Dashboard(data DashboardData) {
	<div class="dashboard">
		<!-- TIMELINE -->
		<div class="db-panel">
			<div class="db-panel-head">
				<span class="db-panel-label">Timeline</span>
				<span class="db-panel-meta">{ data.Date }</span>
			</div>
			<div class="db-timeline-wrap">
				<div class="db-timeline-body">
					@Timeline(data.Tasks.All(), data.Events, data.Sessions, data.Session)
				</div>
			</div>
		</div>

		<!-- FOCUS -->
		<div class="db-panel db-focus">
			if data.Session != nil && (data.Session.Active || data.Session.Paused) {
				@FocusActive(data.Session)
			} else {
				@FocusIdle()
			}
		</div>

		<!-- QUEUE -->
		<div class="db-panel">
			<div class="db-panel-head">
				<span class="db-panel-label">Up Next</span>
				<span class="db-panel-meta">{ fmt.Sprintf("%d tasks", data.Tasks.PendingCount()) }</span>
			</div>
			<div class="db-queue-body">
				@TaskQueue(data.Tasks, data.Session)
			</div>
		</div>

		<!-- AMBIENT -->
		<div class="db-panel db-ambient">
			<div class="db-panel-head">
				<span class="db-panel-label">Today</span>
				<div class="db-status-row">
					<div class={ "db-connection", templ.KV("connected", data.Connected) }>
						<span class="db-connection-dot"></span>
						if data.Connected {
							<span class="db-connection-text">Connected</span>
						} else {
							<span class="db-connection-text">Offline</span>
						}
					</div>
					<button class="db-settings-btn" data-action="open-settings" title="Settings">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="3"/>
							<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
						</svg>
					</button>
				</div>
			</div>
			<div class="db-ambient-body">
				@AmbientPanel(data)
			</div>
		</div>
	</div>
}

// Timeline renders the hour grid with tasks, events, and completed sessions as overlays
templ Timeline(tasks []Task, events []Event, sessions []CompletedSession, currentSession *Session) {
	<div class="db-timeline-grid">
		<!-- Hour markers (background grid) -->
		for hour := 0; hour < 24; hour++ {
			<div class={ "db-hour-marker", templ.KV("now", isNow(hour)), templ.KV("past", isPast(hour)) }>
				<div class="db-hour-num">{ formatHour(hour) }</div>
				<div class="db-hour-line"></div>
			</div>
		}
		<!-- Now indicator -->
		<div class="db-now-line" style={ fmt.Sprintf("top: %s", nowLinePosition()) }></div>
		<!-- Event/Task/Session blocks (overlays) -->
		<div class="db-blocks-layer">
			for _, event := range events {
				<div
					class={ "db-block", "cal", templ.KV("past", isTimePast(event.Time)) }
					style={ blockStyle(event.Time, event.Duration) }
				>
					<div class="db-block-text">
						<div class="db-block-title">{ event.Title }</div>
						if event.Location != "" {
							<div class="db-block-sub">{ event.Location }</div>
						}
					</div>
					if event.Duration != "" {
						<div class="db-block-dur">{ event.Duration }</div>
					}
				</div>
			}
		<!-- Planned task blocks (from drag-drop scheduling) -->
		for _, task := range tasks {
			for _, slot := range task.PlannedSlots {
				<div
					class={ "db-block", "task", "planned", templ.KV("current", task.Status == "in_progress"), templ.KV("past", isSlotFullyPast(slot.StartTime, slot.Duration)) }
					style={ plannedSlotStyle(slot.StartTime, slot.Duration) }
					data-guid={ task.GUID }
					data-start-time={ slot.StartTime }
					data-duration={ fmt.Sprintf("%d", slot.Duration) }
					data-color={ fmt.Sprintf("%d", task.Color) }
					draggable="true"
				>
					<div class="db-block-dot"></div>
					<div class="db-block-text">
						<div class="db-block-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
						if task.Source != "" {
							<div class="db-block-sub">{ task.Source }</div>
						}
					</div>
					<div class="db-block-dur">{ formatMinutes(slot.Duration) }</div>
					<!-- Resize handle -->
					<div class="db-block-resize-handle" data-resize="true"></div>
				</div>
			}
		}
		<!-- Completed session blocks (actual work done) -->
			for i, session := range sessions {
				<div
					class={ "db-block", "session", "completed", sessionColumnClass(sessions, i) }
					style={ sessionBlockStyle(session.StartedAt, session.Elapsed) }
					data-session-id={ session.ID }
				>
					<div class="db-block-text">
						<div class="db-block-title">@templ.Raw(renderMarkdownTitle(session.TaskTitle))</div>
					</div>
					<div class="db-block-dur">{ formatDuration(session.Elapsed) }</div>
				</div>
			}
			<!-- Active session block (in progress, cross-hatched) -->
			if currentSession != nil && (currentSession.Active || currentSession.Paused) {
				<div
					class={ "db-block", "session", "active", templ.KV("paused", currentSession.Paused) }
					style={ activeSessionBlockStyle(currentSession.Elapsed) }
					data-active-session="true"
					data-task-guid={ currentSession.TaskGUID }
					data-elapsed={ fmt.Sprintf("%d", currentSession.Elapsed) }
				>
					<div class="db-block-text">
						<div class="db-block-title">@templ.Raw(renderMarkdownTitle(currentSession.TaskTitle))</div>
					</div>
					<div class="db-block-dur db-active-dur">{ formatDuration(currentSession.Elapsed) }</div>
				</div>
			}
		</div>
	</div>
}

// BlocksAtHour renders task blocks and calendar events at a specific hour
templ BlocksAtHour(tasks []Task, events []Event, hour int) {
	// Show events at this hour
	for _, event := range events {
		if eventAtHour(event, hour) {
			<div class={ "db-block", "cal", templ.KV("past", isPast(hour)) }>
				<div class="db-block-text">
					<div class="db-block-title">{ event.Title }</div>
					if event.Location != "" {
						<div class="db-block-sub">{ event.Location }</div>
					}
				</div>
				if event.Duration != "" {
					<div class="db-block-dur">{ event.Duration }</div>
				}
			</div>
		}
	}
	// Show tasks at this hour (for now, just current task at current hour)
	for _, task := range tasks {
		if task.Status == "in_progress" && isNow(hour) {
			<div class="db-block current" data-guid={ task.GUID }>
				<div class="db-block-dot"></div>
				<div class="db-block-text">
					<div class="db-block-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
					if task.Source != "" {
						<div class="db-block-sub">{ task.Source }</div>
					}
				</div>
				if task.Estimate != "" {
					<div class="db-block-dur">{ task.Estimate }</div>
				}
			</div>
		}
	}
}

// FocusActive renders the focus panel when a session is active or paused
templ FocusActive(session *Session) {
	<div class={ "db-focus-status", templ.KV("paused", session.Paused) }>
		<div class="db-focus-status-dot"></div>
		if session.Paused {
			<span class="db-focus-status-text">Paused</span>
		} else {
			<span class="db-focus-status-text">In Progress</span>
		}
	</div>
	<div class="db-focus-ring-wrap">
		<svg class="db-focus-ring" viewBox="0 0 320 320">
			<circle class="db-ring-bg" cx="160" cy="160" r="150"/>
			<circle class={ "db-ring-progress", templ.KV("paused", session.Paused) } cx="160" cy="160" r="150" id="ring-progress"/>
		</svg>
		<div class="db-focus-center">
			<div class={ "db-focus-time", templ.KV("paused", session.Paused) } id="timer">{ formatElapsed(session.Elapsed) }</div>
			if session.Paused {
				<div class="db-focus-unit">paused</div>
			} else {
				<div class="db-focus-unit">elapsed</div>
			}
		</div>
	</div>
	<div class="db-focus-task">@templ.Raw(renderMarkdownTitle(session.TaskTitle))</div>
	if session.TaskSource != "" {
		<div class="db-focus-source">{ session.TaskSource }</div>
	}
	<div class="db-focus-actions">
		if session.Paused {
			<button class="db-btn db-btn-primary" data-action="resume-session">▶ Resume</button>
			<button class="db-btn db-btn-ghost" data-action="complete-session">✓ Complete</button>
		} else {
			<button class="db-btn db-btn-ghost" data-action="pause-session">⏸ Pause</button>
			<button class="db-btn db-btn-primary" data-action="complete-session">✓ Complete</button>
		}
	</div>
}

// FocusIdle renders the focus panel when no session is active
templ FocusIdle() {
	<div class="db-focus-idle">
		<div class="db-focus-ring-wrap">
			<svg class="db-focus-ring" viewBox="0 0 320 320">
				<circle class="db-ring-bg" cx="160" cy="160" r="150"/>
				<circle class="db-ring-progress idle" cx="160" cy="160" r="150"/>
			</svg>
			<div class="db-focus-center">
				<div class="db-focus-time idle">0:00</div>
				<div class="db-focus-unit">ready</div>
			</div>
		</div>
		<div class="db-focus-task idle">Select a task to begin</div>
		<div class="db-focus-hint">Choose from the queue or timeline</div>
	</div>
}

// TaskQueue renders the task queue with three sections: scheduled, floating, done
templ TaskQueue(tasks GroupedTasks, session *Session) {
	if len(tasks.Scheduled) == 0 && len(tasks.Floating) == 0 && len(tasks.Done) == 0 {
		<div class="db-queue-empty">
			<div class="db-queue-empty-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
					<rect x="9" y="3" width="6" height="4" rx="1"/>
				</svg>
			</div>
			<p class="db-queue-empty-title">No tasks for today</p>
			<p class="db-queue-empty-hint">Add tasks to your daily note in Thymer</p>
		</div>
	} else {
		// Scheduled section - tasks with planned time slots
		if len(tasks.Scheduled) > 0 {
			<div class="db-q-section scheduled">
				<div class="db-q-section-header">
					<span class="db-q-section-icon">⏰</span>
					<span class="db-q-section-title">Scheduled</span>
					<span class="db-q-section-count">{ fmt.Sprintf("%d", len(tasks.Scheduled)) }</span>
				</div>
				for _, task := range tasks.Scheduled {
					@TaskCardScheduled(task, session)
				}
			</div>
		}
		// Floating section - unscheduled tasks, user can reorder
		if len(tasks.Floating) > 0 {
			<div class="db-q-section floating" data-section="floating">
				<div class="db-q-section-header">
					<span class="db-q-section-icon">📋</span>
					<span class="db-q-section-title">Up Next</span>
					<span class="db-q-section-count">{ fmt.Sprintf("%d", len(tasks.Floating)) }</span>
				</div>
				for _, task := range tasks.Floating {
					@TaskCard(task, session)
				}
			</div>
		}
		// Done section - completed tasks
		if len(tasks.Done) > 0 {
			<div class="db-q-section done">
				<div class="db-q-section-header">
					<span class="db-q-section-icon">✓</span>
					<span class="db-q-section-title">Done</span>
					<span class="db-q-section-count">{ fmt.Sprintf("%d", len(tasks.Done)) }</span>
				</div>
				for _, task := range tasks.Done {
					@TaskCardDone(task)
				}
			</div>
		}
	}
}

// TaskCard renders a single task card with session controls
templ TaskCard(task Task, session *Session) {
	<div
		class={ "db-q-item", templ.KV("active", session != nil && session.TaskGUID == task.GUID && session.Active), templ.KV("paused", session != nil && session.TaskGUID == task.GUID && session.Paused) }
		data-guid={ task.GUID }
	>
		<div class="db-q-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
		<div class="db-q-footer">
			<span class="db-q-source">{ task.Source }</span>
			<div class="db-q-controls">
				if session != nil && session.TaskGUID == task.GUID && session.Active {
					// This task is actively running - show pause
					<button class="db-q-btn" data-action="pause-session" data-guid={ task.GUID } title="Pause">
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
							<rect x="6" y="4" width="4" height="16" rx="1"/>
							<rect x="14" y="4" width="4" height="16" rx="1"/>
						</svg>
					</button>
				} else if session != nil && session.TaskGUID == task.GUID && session.Paused {
					// This task is paused - show play
					<button class="db-q-btn" data-action="resume-session" data-guid={ task.GUID } title="Resume">
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
							<path d="M8 5v14l11-7z"/>
						</svg>
					</button>
				} else {
					// No session or different task - show play to start
					<button class="db-q-btn" data-action="start-task" data-guid={ task.GUID } title="Start">
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
							<path d="M8 5v14l11-7z"/>
						</svg>
					</button>
				}
			</div>
			if task.ElapsedToday > 0 {
				<span class="db-q-elapsed">{ formatDuration(task.ElapsedToday) }</span>
			} else if task.Estimate != "" {
				<span class="db-q-estimate">~{ task.Estimate }</span>
			} else {
				<span class="db-q-elapsed-empty"></span>
			}
		</div>
	</div>
}

// TaskCardScheduled renders a scheduled task card with time badge (not draggable for reorder)
templ TaskCardScheduled(task Task, session *Session) {
	<div
		class={ "db-q-item", "scheduled", templ.KV("active", session != nil && session.TaskGUID == task.GUID && session.Active), templ.KV("paused", session != nil && session.TaskGUID == task.GUID && session.Paused) }
		data-guid={ task.GUID }
	>
		<div class="db-q-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
		<div class="db-q-footer">
			<span class="db-q-source">{ task.Source }</span>
			// Show time badge for first planned slot
			if len(task.PlannedSlots) > 0 {
				<span class="db-q-time-badge">{ formatSlotTime(task.PlannedSlots[0].StartTime) }</span>
			}
			<div class="db-q-controls">
				if session != nil && session.TaskGUID == task.GUID && session.Active {
					<button class="db-q-btn" data-action="pause-session" data-guid={ task.GUID } title="Pause">
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
							<rect x="6" y="4" width="4" height="16" rx="1"/>
							<rect x="14" y="4" width="4" height="16" rx="1"/>
						</svg>
					</button>
				} else if session != nil && session.TaskGUID == task.GUID && session.Paused {
					<button class="db-q-btn" data-action="resume-session" data-guid={ task.GUID } title="Resume">
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
							<path d="M8 5v14l11-7z"/>
						</svg>
					</button>
				} else {
					<button class="db-q-btn" data-action="start-task" data-guid={ task.GUID } title="Start">
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
							<path d="M8 5v14l11-7z"/>
						</svg>
					</button>
				}
			</div>
			if task.ElapsedToday > 0 {
				<span class="db-q-elapsed">{ formatDuration(task.ElapsedToday) }</span>
			}
		</div>
	</div>
}

// TaskCardDone renders a completed task card
templ TaskCardDone(task Task) {
	<div class="db-q-item done" data-guid={ task.GUID }>
		<div class="db-q-title">@templ.Raw(renderMarkdownTitle(task.Title))</div>
		<div class="db-q-footer">
			<span class="db-q-source">{ task.Source }</span>
			<div class="db-q-controls"></div>
			if task.ElapsedToday > 0 {
				<span class="db-q-elapsed">{ formatDuration(task.ElapsedToday) }</span>
			}
		</div>
	</div>
}

// AmbientPanel renders the right sidebar with stats, calendar, habits
templ AmbientPanel(data DashboardData) {
	<!-- Stats -->
	<div class="db-stats">
		<div class="db-stat">
			<span class="db-stat-icon">📋</span>
			<span class="db-stat-val">{ fmt.Sprintf("%d", data.Stats.Planned) }</span>
		</div>
		<div class="db-stat">
			<span class="db-stat-icon">✓</span>
			<span class={ "db-stat-val", templ.KV("good", data.Stats.Completed > 0) }>{ fmt.Sprintf("%d", data.Stats.Completed) }</span>
		</div>
		<div class="db-stat">
			<span class="db-stat-icon">⏳</span>
			<span class="db-stat-val">{ fmt.Sprintf("%d", data.Stats.Queued) }</span>
		</div>
	</div>

	<!-- Upcoming Calendar -->
	<div class="db-upcoming">
		<div class="db-section-label">Coming Up</div>
		if len(data.Events) == 0 {
			<div class="db-upcoming-empty">No events today</div>
		} else {
			for _, event := range data.Events {
				<div class="db-up-item">
					<span class="db-up-time">{ event.Time }</span>
					<span class="db-up-title">{ event.Title }</span>
				</div>
			}
		}
	</div>

	<!-- Habits -->
	<div class="db-habits">
		<div class="db-section-label">Habits</div>
		if len(data.Habits) == 0 {
			<div class="db-habits-empty">No habits configured</div>
		} else {
			for _, habit := range data.Habits {
				<div
					class={ "db-habit-item", habit.Type, templ.KV("done", habit.Done) }
					data-habit={ habit.ID }
					data-action="toggle-habit"
				>
					<span class="db-habit-icon">{ habit.Icon }</span>
					<div class="db-habit-info">
						<div class="db-habit-name">{ habit.Name }</div>
						<div class="db-habit-track">
							<div class="db-habit-progress" style={ fmt.Sprintf("width: %d%%", habit.Progress) }></div>
						</div>
					</div>
					<div class="db-habit-check">
						if habit.Done {
							if habit.Type == "vice" {
								✗
							} else {
								✓
							}
						}
					</div>
				</div>
			}
		}
	</div>
}
